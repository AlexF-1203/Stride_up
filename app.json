{
  "expo": {
    "name": "Stride Up",
    "slug": "stride-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/imgage_fond.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1B1E"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ginn1203.strideup",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1A1B1E"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "57da7f27-4217-46a7-9377-6172a8e29202"
      }
    },
    "owner": "ginn1203"
  }
}
